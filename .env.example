# AgricultureID environment configuration (all optional in Phase 1).
# Copy to .env.local to override. The app builds and runs without any of these.

# Canonical site origin used for absolute URLs (canonical tags, sitemap, OG).
# Defaults to https://agricultureid.com when unset.
# NEXT_PUBLIC_SITE_URL=https://agricultureid.com

# WebmasterID analytics loads on every page with the site owner's public
# identifiers, hardcoded in components/analytics/Analytics.tsx — no env var
# required.

# Set automatically by Netlify on every build — never set this by hand.
# `production` on the production deploy; `deploy-preview` / `branch-deploy` /
# `dev` otherwise. app/robots.ts serves `Disallow: /` for the non-production
# values so preview hosts stay out of the index (see lib/deploy-context.ts).
# CONTEXT=
